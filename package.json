{
  "name": "webdaw",
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "publish": "pwsh ci/publish.ps1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 8083",
    "test": "vitest run",
    "docker": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docker.ps1",
    "deploy:demos": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1 demo*",
    "deploy:patches": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1 patch*"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "tone": "^15.0.4"
  },
  "devDependencies": {
    "@marmooo/soundfont-parser": "^0.1.9",
    "puppeteer-core": "^25.3.0",
    "typescript": "^5.5.4",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}